<section class="compteurs-honnetes section" id="le-bureau-en-chiffres">
  <div class="container">

    <div class="compteurs-honnetes__grid">
      <div class="compteur-item">
        <span class="compteur-item__nb">3</span>
        <span class="compteur-item__label">podcasts en route</span>
      </div>
      <div class="compteur-item">
        <span class="compteur-item__nb">{{ collections.posts | length }}</span>
        <span class="compteur-item__label">article{{ 's' if (collections.posts | length) > 1 }} publié{{ 's' if (collections.posts | length) > 1 }}</span>
      </div>
      <div class="compteur-item">
        <span class="compteur-item__nb">8</span>
        <span class="compteur-item__label">partenaires en discussion</span>
      </div>
    </div>

    <p class="compteurs-honnetes__note">Le Bureau démarre. Chaque mois, ces chiffres montent.</p>

  </div>
</section>
