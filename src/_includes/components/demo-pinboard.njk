                  <div class="postit" style="--tour: 0deg; --rang: 1;">
                    <span class="postit__tampon">aujourd’hui</span>
                    <span class="postit__v" data-mot="long">TVA de septembre</span>
                    <span class="postit__s">obligation · échéance le 15</span>
                    <span class="postit__gestes"><span class="postit__g">Fait</span></span>
                  </div>
                  <div class="postit" style="--tour: 0.7deg; --rang: 2;">
                    <span class="postit__tampon">aujourd’hui</span>
                    <span class="postit__v" data-mot="oui">Caves Bertrand &amp; Fils</span>
                    <span class="postit__s">ton rappel du jour</span>
                    <span class="postit__gestes"><span class="postit__g">Appelé</span></span>
