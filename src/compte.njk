permalink: /compte/
---

<section class="about-hero">
  <div class="container">
    <h1>Ton compte</h1>
  </div>
</section>

<section class="waitlist">
  <div class="container">

    <div class="waitlist__header" id="compteInvite">
      <p class="waitlist__eyebrow">Gratuit</p>
      <h2>Ouvre ton bureau.<br>Un email, un mot de passe.</h2>
      <p class="waitlist__sub waitlist__sub--lecture">
        Le compte est gratuit et ouvert à toute la filière. Il sert à retrouver ce que tu as
        trouvé : les articles que tu mets de côté, les webinaires et les interviews, les outils,
        et l'édition si tu la veux.
      </p>
      <p class="waitlist__sub waitlist__sub--lecture">
        Juste après, on te pose cinq questions rapides : ton prénom, ce que tu fais, le nom de ta
        structure, ton code postal, et si tu travailles avec Vitisoft. Elles servent à deux choses, et autant te le dire franchement : te montrer
        ce qui te concerne plutôt que tout le reste, et proposer aux partenaires de la filière un
        espace visible par les bons interlocuteurs. Tu peux les passer, ton compte marche quand
        même.
      </p>
      <p class="waitlist__sub waitlist__sub--lecture"><b>Tes ventes ne servent jamais à ça.</b> Les lignes de ton export
        Vitisoft alimentent ton bureau, et rien d'autre : aucun ciblage, aucune
        statistique partagée, rien qui parte chez un partenaire. Elles sont enregistrées sur ton
        compte, hébergé en Europe, pour que tu les retrouves depuis n'importe quel appareil.</p>
      <p class="waitlist__sub waitlist__sub--lecture"><b>Les écrans de vente sont réservés aux utilisateurs de
        Vitisoft.</b> Ils lisent le fichier d'export de Vitisoft et refusent tout autre format. Le
        reste du bureau est ouvert à tous.</p>
    </div>

    <div class="waitlist__header" id="compteConnecte" hidden>
      <p class="waitlist__eyebrow">Connecté</p>
      <h2>Te voilà chez toi.</h2>
      <p class="waitlist__sub">Tu es connecté avec <b id="compteEmail"></b>.</p>
    </div>

    <div class="waitlist__proof" id="compteProof">
      <span class="waitlist__proof-item">Vignerons</span>
      <span class="waitlist__proof-sep">·</span>
      <span class="waitlist__proof-item">Étudiants vin</span>
      <span class="waitlist__proof-sep">·</span>
      <span class="waitlist__proof-item">Pros filière</span>
    </div>

    <div class="waitlist__form-wrap" style="text-align:center">
      <a href="/compte/" class="btn" id="compteBtnOuvrir"
         data-bdv-compte data-bdv-mode="inscription"
         data-bdv-titre="Ton bureau t'attend.">Créer mon compte</a>
      <p id="compteDejaInscrit" style="margin-top:.9rem">Tu as déjà un compte ?
        <a href="/compte/?mode=connexion" id="compteBtnConnexion" data-bdv-compte
           data-bdv-mode="connexion" data-bdv-titre="Content de te revoir.">Me connecter</a></p>
      <a href="/mon-bureau/" class="btn" id="compteBtnTableau" hidden>Ouvrir mon bureau</a>
      <button type="button" class="btn btn--ghost" id="compteBtnSortir" hidden>Me déconnecter</button>
    </div>

    <p class="waitlist__reassurance">Teddy Pereira · Co-fondateur Solumatic · Nantes · Données hébergées en Europe</p>

  </div>
</section>

<script>
(function(){
  'use strict';
  // Cette page a deux etats, et un seul est vrai a la fois. Le basculement se lit dans
  // localStorage sans attendre bdv-compte.js, charge en defer : sinon la page proposerait de
  // creer un compte pendant une fraction de seconde a quelqu'un qui en a deja un.
  function session(){
    try{
      var s = JSON.parse(localStorage.getItem('bdv_session'));
      return (s && s.access_token && s.user) ? s : null;
    }catch(e){ return null; }
  }
  function afficher(){
    var s = session();
    document.getElementById('compteInvite').hidden = !!s;
    document.getElementById('compteProof').hidden = !!s;
    document.getElementById('compteConnecte').hidden = !s;
    document.getElementById('compteBtnOuvrir').hidden = !!s;
    document.getElementById('compteDejaInscrit').hidden = !!s;
    document.getElementById('compteBtnTableau').hidden = !s;
    document.getElementById('compteBtnSortir').hidden = !s;
    if(s) document.getElementById('compteEmail').textContent = s.user.email;
  }
  afficher();
  // Meme evenement que le bandeau du haut : la page reflete l'etat sans rechargement.
  document.addEventListener('bdv:session', afficher);

  // Depuis le 07/09/2026 ce bouton EFFACE le navigateur. Il ne peut plus se cliquer sans
  // avertissement. Le garde-fou complet (comparaison des lignes locales et du compte) vit
  // dans le bureau, qui a deja tout ce qu'il faut sous la main ; ici on previent, au moins.
  document.getElementById('compteBtnSortir').addEventListener('click', function(){
    if(!confirm('Te déconnecter ?\n\nCe navigateur sera vidé : lignes de vente, notes de '
      + 'suivi et réglages. Tout reste sur ton compte et redescendra à ta prochaine '
      + 'connexion. Si un import n\'est pas encore remonté, vérifie-le depuis ton bureau '
      + 'avant de partir.')) return;
    if(window.BdvCompte) BdvCompte.deconnexion();
    afficher();
  });

  // La fenetre ne s'ouvre PLUS toute seule a l'arrivee nue sur /compte/. Elle le faisait tant
  // que cette page n'avait rien a dire ; depuis le 06/09/2026 elle porte la promesse (ce qu'on
  // demande, a quoi ca sert, ce qu'on ne fait jamais des ventes), et une fenetre posee par
  // dessus la rendait illisible. Le bouton ouvre la meme fenetre au clic, via data-bdv-compte.
  //
  // UNE exception, posee le 07/09/2026 : /compte/?mode=connexion. C'est l'adresse de l'entree
  // « Connexion » du menu quand le clic n'a pas ete intercepte (nouvel onglet, lien copie,
  // module pas encore charge). L'intention y est deja exprimee : faire relire toute la
  // promesse d'inscription a quelqu'un qui demande a se connecter serait le meme defaut
  // qu'avant, dans l'autre sens.
  if(!session() && /(^|[?&])mode=connexion(&|$)/.test(location.search)){
    // bdv-compte.js est charge en defer : il n'existe pas encore au moment ou ce script tourne.
    window.addEventListener('load', function(){
      if(window.BdvCompte && !BdvCompte.session()){
        // Le renvoi vers le bureau est ecrit ici en plus de la delegation de clic : cette
        // ouverture-la ne passe pas par un bouton, elle n'a donc pas de data-bdv-apres.
        BdvCompte.ouvrir({ mode: 'connexion', titre: 'Content de te revoir.' })
          .then(function(s){ if(s) location.href = '/mon-bureau/'; });
      }
    });
  }
})();
</script>
