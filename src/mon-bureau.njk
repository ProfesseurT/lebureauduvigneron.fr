---
layout: base.njk
title: Mon bureau
description: Ce qui presse, ce que tu as mis de côté, tes outils et tes chiffres.
permalink: /mon-bureau/
---

{# Les contenus du site et les echeances, poses une fois, lus par le script plus bas. #}
<script id="bdvContenus" type="application/json">
[{% for post in collections.posts %}{"url":{{ post.url | dump | safe }},"titre":{{ post.data.title | dump | safe }},"date":"{{ post.date | dateISO }}","pilier":{{ (post.data.pilier or "") | dump | safe }},"temps":{{ (post.data.temps_lecture or "") | dump | safe }}}{% if not loop.last %},
{% endif %}{% endfor %}]
</script>
<script id="bdvEcheances" type="application/json">
{{ echeances | dump | safe }}
</script>

<!-- DECONNECTE : une invitation, pas une page d'erreur. -->
<section class="about-hero" id="bureauInviteHero" hidden>
  <div class="container">
    <p class="section__label" style="color:var(--on-dark-soft)">Ton espace</p>
    <h1>Mon bureau</h1>
  </div>
</section>
<section class="section" id="bureauInvite" hidden>
  <div class="container">
    <div class="bureau-vide">
      <h2>Ton bureau t'attend.</h2>
      <p>Le compte est gratuit et ouvert à toute la filière. Il te dit ce qui presse, garde ce que
        tu mets de côté, et range ce que tu as déjà lu.</p>
      <p>
        <a href="/compte/" class="btn btn--bordeaux" data-bdv-compte
           data-bdv-titre="Ton bureau t'attend.">Créer mon compte ou me connecter</a>
      </p>
    </div>
  </div>
</section>

<!-- CONNECTE -->
<div id="bureauContenu" hidden>

  <section class="bureau-tete">
    <div class="container--bureau bureau-tete__ligne">
      <div>
        <p class="bureau-tete__jour" id="bureauJour"></p>
        <h1 id="bureauSalut">Te voilà chez toi.</h1>
        <!-- La plaque : le nom du domaine, comme sur une porte de bureau. Elle n'apparait
             que s'il l'a donne : un cadre vide qui annonce ce qui manque se remarque plus
             qu'une absence. -->
        <p class="bureau-tete__plaque" id="bureauPlaque" hidden></p>
        <p class="bureau-tete__resume" id="bureauResume"></p>
      </div>
      <div class="bureau-tete__actions">
        <button class="bureau-tete__reglages" id="bureauOuvrirReglages" type="button">Mes réglages</button>
        <!-- Se déconnecter EFFACE ce navigateur. Le bouton est donc volontairement discret et
             en second : une action définitive n'a pas à attirer l'oeil autant que les
             réglages, et elle ne doit jamais se cliquer par réflexe. -->
        <button class="bureau-tete__sortir" id="bureauSortir" type="button">Me déconnecter</button>
        <p class="bureau-tete__sortir-avis" id="bureauSortirAvis" role="status" hidden></p>
      </div>
    </div>
  </section>

  <div class="container--bureau bureau-plan">

    <!-- LE SOUS-MAIN : ce qu'on fait aujourd'hui. La zone la plus large, en haut a gauche. -->
    <section class="zone zone--sousmain">
      <div class="zone__tete">
        <h2>Le sous-main</h2>
        <span class="zone__note" id="fileNote"></span>
      </div>
      <p class="bureau-avis" id="bureauAvis" hidden></p>
      <div id="bureauFile"></div>
      <p class="zone__pied" id="filePied" hidden></p>
    </section>

    <!-- LE MOT DU JOUR : un conseil, un seul, celui qui pese le plus lourd. -->
    <section class="zone zone--mot" id="zoneMot" hidden>
      <div class="zone__tete">
        <h2>Le mot du jour</h2>
        <span class="zone__note" id="motNote"></span>
      </div>
      <div id="bureauMot"></div>
    </section>

    <!-- LE PENSE-BETE : l'echeance qui tombe, et rien d'autre. -->
    <section class="zone zone--pensebete">
      <div class="zone__tete"><h2>Le pense-bête</h2></div>
      <div id="bureauEcheance"></div>
    </section>

    <!-- L'ARDOISE : les chiffres, tels que le tableau de bord les a laisses. -->
    <section class="zone zone--ardoise" id="zoneArdoise" hidden>
      <div class="zone__tete">
        <h2>L'ardoise</h2>
        <span class="zone__note" id="ardoiseQuand"></span>
      </div>
      <div class="ardoise" id="bureauChiffres"></div>
    </section>

    <!-- LE PANNEAU DE LIEGE : les chiffres de sa PRATIQUE, pas ceux de ses ventes.
         L'ardoise dit ou en est le domaine, le panneau dit ou il en est, lui. Deux
         tableaux de chiffres sur une meme page ne tiennent qu'a cette condition. -->
    <section class="zone zone--panneau" id="zonePanneau" hidden>
      <div class="zone__tete">
        <h2>Le panneau</h2>
        <span class="zone__note" id="panneauNote"></span>
      </div>
      <div class="panneau" id="bureauPanneau"></div>
    </section>

    <!-- LA PILE DE LECTURE -->
    <section class="zone zone--lecture">
      <div class="zone__tete">
        <h2>À lire</h2>
        <span class="zone__note" id="compteALire"></span>
      </div>
      <div id="bureauALire"></div>
    </section>

    <!-- LE CLASSEUR -->
    <section class="zone zone--classeur">
      <div class="zone__tete">
        <h2>Le classeur</h2>
        <span class="zone__note" id="compteLu"></span>
      </div>
      <div id="bureauLu"></div>
    </section>

    <!-- LE COURRIER -->
    <section class="zone zone--courrier">
      <div class="zone__tete">
        <h2>Le courrier</h2>
        <span class="zone__note" id="compteCourrier"></span>
      </div>
      <div id="bureauCourrier"></div>
    </section>

    <!-- LE TIROIR : les outils. En bas, parce qu'on sait ou ils sont. -->
    <section class="zone zone--tiroir">
      <div class="zone__tete"><h2>Le tiroir</h2></div>
      <div class="tiroir">
        <a class="tiroir__o" href="/outils/echeances/">
          <span class="tiroir__nom">Le compte à rebours</span>
          <span class="tiroir__q">DRM, DAI, récolte, facturation électronique</span>
        </a>
        <a class="tiroir__o" href="/outils/dashboard-vigneron/" id="tiroirDash">
          <span class="tiroir__nom">Le tableau de bord</span>
          <span class="tiroir__q">Tes ventes, tes clients, tes cuvées</span>
        </a>
      </div>
    </section>

  </div>

  <!-- La fiche de suivi, en surimpression. On ne quitte pas le bureau pour travailler
       un client : c'est ici qu'on pose un geste, ici qu'on lit ce qui s'est dit. -->
  <div class="voile" id="voile" hidden>
    <div class="ficheb" role="dialog" aria-modal="true" aria-labelledby="ficheNom">
      <button class="ficheb__x" id="ficheFermer" type="button" aria-label="Fermer">&#215;</button>
      <!-- L'avis de la fiche vit DANS la fiche. Le meme message pose dans le sous-main
           tombait derriere le voile : le vigneron voyait son bouton redevenir cliquable
           sans savoir pourquoi, et decouvrait l'erreur bien plus tard, hors contexte. -->
      <p class="bureau-avis" id="ficheAvis" role="status" hidden></p>
      <div id="ficheContenu"></div>
    </div>
  </div>

  <!-- LES REGLAGES ont quitte cette page le 07/09/2026. Ils vivent dans
       /js/bdv-reglages.js : un panneau unique, que le bureau ET le tableau de bord
       ouvrent. Il pose son markup et son style lui-meme, il n'y a plus rien a declarer
       ici, et plus deux endroits ou lire son objectif de CA en se demandant lequel dit
       vrai. -->
</div>

<!-- LE MOTEUR DE LA BASE, au bureau aussi depuis le 07/09/2026. C'est ce qui permet au
     panneau de reglages d'y montrer « Ma base » et « Le classement » pour de vrai, et pas un
     renvoi : ces deux blocs sont des CALCULS sur les lignes de vente, pas des affichages.
     Trois conditions, dans cet ordre :
       1. PapaParse avant le moteur, il lit le CSV de l'export.
       2. bdv-sync.js, sinon un import fait d'ici n'arriverait jamais sur le compte : syncPret()
          rendrait faux en silence, et on refabriquerait la panne de 500 lignes du matin.
       3. bdv-base.js SANS defer et AVANT le script de cette page. Un script differe
          s'execute apres l'analyse du document, donc trop tard. Voir son entete. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="/js/bdv-sync.js"></script>
<script src="/js/bdv-base.js"></script>
<script src="/js/bdv-reglages.js" defer></script>
<script src="/js/bdv-canaux.js"></script>
<script src="/js/bdv-echeances.js" defer></script>
<script src="/js/bdv-crm.js" defer></script>
<script>
(function(){
  'use strict';

  /* Le bureau : des zones nommees, toujours a la meme place. On ne cherche pas ses
     affaires sur un bureau, on sait ou elles sont. Le sous-main est le plus grand parce
     que c'est la qu'on travaille ; le tiroir est en bas parce qu'on l'ouvre rarement.

     Regle qui gouverne toute la page : LA FILE NE MONTRE QUE CINQ LIGNES. Quarante
     clients a traiter n'est pas une journee, c'est un mur, et un mur on cesse de le
     regarder. Le reste est a un clic, dans le tableau de bord. */
  var FILE_VUE = 5;
  var TOUT_VOIR = false;

  function session(){
    try{
      var s = JSON.parse(localStorage.getItem('bdv_session'));
      return (s && s.access_token && s.user) ? s : null;
    }catch(e){ return null; }
  }
  var connecte = !!session();
  document.getElementById('bureauInviteHero').hidden = connecte;
  document.getElementById('bureauInvite').hidden = connecte;
  document.getElementById('bureauContenu').hidden = !connecte;
  if(!connecte) return;

  function el(id){ return document.getElementById(id); }
  function txt(n, t){ if(n) n.textContent = t; }
  function vide(boite, phrase){
    boite.innerHTML = '';
    var p = document.createElement('p');
    p.className = 'zone__vide';
    p.textContent = phrase;
    boite.appendChild(p);
  }
  function euros(n){ return Math.round(n).toLocaleString('fr-FR') + ' €'; }

  var CONTENUS = [];
  try{ CONTENUS = JSON.parse(el('bdvContenus').textContent) || []; }catch(e){}
  var PAR_URL = {};
  CONTENUS.forEach(function(c){ PAR_URL[c.url] = c; });

  function signets(){
    try{ return JSON.parse(localStorage.getItem('bdv_signets_v1')) || {}; }
    catch(e){ return {}; }
  }
  function parEtat(etat){
    var s = signets();
    return Object.keys(s).filter(function(r){ return s[r].etat === etat; });
  }

  /* ---------------- L'EN-TETE ---------------- */
  var jour = new Date().toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long' });
  txt(el('bureauJour'), jour.charAt(0).toUpperCase() + jour.slice(1));

  /* ---------------- LE SOUS-MAIN : LA FILE ----------------
     Chaque ligne est cliquable et mene DROIT a la fiche du client dans le tableau de
     bord, pas a une liste ou il faudrait le rechercher. Les trois gestes restent a
     droite, toujours a la meme place, pour descendre la file sans relire. */
  var ETAT_FILE = null;

  function lienFiche(id){
    return '/outils/dashboard-vigneron/#client=' + encodeURIComponent(id);
  }

  function ligneFile(l){
    var a = document.createElement('button');
    a.type = 'button';
    a.className = 'tache';
    a.setAttribute('data-fiche', l.id);
    a.setAttribute('data-source', l.source);

    var gauche = document.createElement('span');
    gauche.className = 'tache__qui';
    var nom = document.createElement('span');
    nom.className = 'tache__nom';
    nom.textContent = l.nom || l.id;
    gauche.appendChild(nom);
    var pourquoi = document.createElement('span');
    pourquoi.className = 'tache__pourquoi';
    pourquoi.textContent = l.source === 'rappel'
      ? (l.retard > 0 ? 'Tu devais le rappeler il y a ' + l.retard + ' jour' + (l.retard > 1 ? 's' : '')
                      : 'À rappeler aujourd’hui')
      : (l.montant ? euros(l.montant) + ' ' + (l.lib || '') : (l.detail || 'Signalé'));
    gauche.appendChild(pourquoi);
    a.appendChild(gauche);

    var droite = document.createElement('span');
    droite.className = 'tache__gestes';
    Object.keys(BdvCrm.GESTES).forEach(function(k){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn--geste';
      b.setAttribute('data-geste', k);
      b.setAttribute('data-id', l.id);
      b.textContent = BdvCrm.GESTES[k].label;
      droite.appendChild(b);
    });
    a.appendChild(droite);
    return a;
  }

  var LECTURE_KO = false;
  function peindreFile(){
    var boite = el('bureauFile');
    if(!window.BdvCrm || !ETAT_FILE){
      vide(boite, LECTURE_KO
        ? 'Ta file n’a pas pu être lue. Ce n’est pas qu’elle est vide : réessaie tout à l’heure.'
        : 'Ouvre ton tableau de bord une fois : il déposera ici les clients à rappeler.');
      return;
    }
    var lignes = BdvCrm.file(ETAT_FILE);
    if(!lignes.length){
      vide(boite, 'Rien à faire aujourd’hui. Profites-en.');
      txt(el('fileNote'), '');
      el('filePied').hidden = true;
      return;
    }
    var retards = lignes.filter(function(l){ return l.source === 'rappel' && l.retard > 0; }).length;
    txt(el('fileNote'), retards ? retards + ' en retard' : lignes.length + ' en attente');

    boite.innerHTML = '';
    lignes.slice(0, TOUT_VOIR ? lignes.length : FILE_VUE).forEach(function(l){ boite.appendChild(ligneFile(l)); });

    // « Tout voir » déplie la file ICI. Sauter vers le tableau de bord faisait sortir du
    // poste de travail pour retrouver une liste d'analyse, qui n'est pas la même chose.
    var pied = el('filePied');
    if(lignes.length > FILE_VUE){
      pied.innerHTML = '';
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn--lienb';
      b.textContent = TOUT_VOIR
        ? 'N’en montrer que ' + FILE_VUE
        : 'Voir les ' + (lignes.length - FILE_VUE) + ' autres';
      b.onclick = function(){ TOUT_VOIR = !TOUT_VOIR; peindreFile(); };
      pied.appendChild(b);
      pied.hidden = false;
    }else pied.hidden = true;
  }

  // Le clic sur un geste ne doit pas suivre le lien de la ligne.
  document.addEventListener('click', function(e){
    var t = e.target.closest && e.target.closest('[data-fiche]');
    if(t && !(e.target.closest && e.target.closest('[data-geste]'))){
      ouvrirFiche(t.getAttribute('data-fiche'));
      return;
    }
    var b = e.target.closest && e.target.closest('[data-geste]');
    if(!b || !window.BdvCrm) return;
    e.preventDefault();
    e.stopPropagation();
    var id = b.getAttribute('data-id');
    var ligne = b.closest('.tache');
    if(ligne) ligne.classList.add('tache--partie');
    BdvCrm.geste(b.getAttribute('data-geste'), id).then(function(ok){
      ETAT_FILE = BdvCrm.miroir();
      peindreFile(); peindreResume();
      // Le miroir vient d'etre elague de ce client : le panneau compterait un carnet plus
      // court et ignorerait le rappel qu'on vient de poser. On le repeint sur la verite
      // du serveur, pas sur l'optimisme local.
      if(ok) BdvCrm.charger().then(function(etat){
        if(!etat) return;
        ETAT_FILE = etat;
        peindreFile(); peindreArdoise(); peindrePanneau(); peindreResume();
      });
      if(!ok){
        var av = el('bureauAvis');
        av.textContent = 'Pas de réseau : ce geste est mis de côté et repartira tout seul à ta prochaine visite.';
        av.hidden = false;
      }
    });
  });

  /* ---------------- LA FICHE DE SUIVI, EN SURIMPRESSION ----------------
     On ne quitte pas le bureau pour travailler un client. Cette fiche montre ce que la
     base sait de lui : sa prochaine action, ses coordonnees, et le fil de ce qui s'est
     dit. Elle ne montre PAS ses ventes, ses cuvees ni ses factures : ces chiffres sont
     calcules par le tableau de bord, et le bureau ne recalcule jamais rien. Un lien mene
     a sa fiche complete pour qui veut le detail. */
  var FICHE_ID = null;
  var CANAL_SAISIE = (window.BdvCanaux ? BdvCanaux.DEFAUT : 'appel');
  // L'entree du journal en cours de correction, et le texte tape mais pas encore
  // enregistre. La fiche se repeint a chaque geste et a chaque reponse reseau : sans ces
  // deux variables, une correction a moitie ecrite disparaissait sans un mot.
  var EDITION_ID = null;
  var EDITION_TXT = null;
  var EDITION_CANAL = null;

  var RETOUR_FICHE = null;
  function avisFiche(texte, ok){
    var a = el('ficheAvis');
    a.textContent = texte || '';
    a.setAttribute('data-ok', ok ? 'oui' : 'non');
    a.hidden = !texte;
  }
  function fermerFiche(){
    el('voile').hidden = true;
    document.body.style.overflow = '';
    FICHE_ID = null;
    avisFiche('');
    if(RETOUR_FICHE && RETOUR_FICHE.focus) RETOUR_FICHE.focus();
    RETOUR_FICHE = null;
  }
  el('ficheFermer').addEventListener('click', fermerFiche);
  el('voile').addEventListener('click', function(e){ if(e.target === el('voile')) fermerFiche(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !el('voile').hidden) fermerFiche(); });

  function ouvrirFiche(id){
    if(!window.BdvCrm) return;
    RETOUR_FICHE = document.activeElement;
    FICHE_ID = id;
    CANAL_SAISIE = (window.BdvCanaux ? BdvCanaux.DEFAUT : 'appel');
    EDITION_ID = null; EDITION_TXT = null; EDITION_CANAL = null;
    avisFiche('');
    el('voile').hidden = false;
    document.body.style.overflow = 'hidden';
    el('ficheFermer').focus();
    peindreFiche();
    BdvCrm.fil(id).then(function(f){ if(FICHE_ID === id) peindreFiche(f); });
  }

  function infosDe(id){
    var e = ETAT_FILE || {};
    var s = (e.signaux || []).filter(function(x){ return x.id === id; })[0] || {};
    var su = (e.suivi || e.rappels || []).filter(function(x){ return x.id === id; })[0] || {};
    return { nom: s.nom || (e.noms || {})[id] || id, contact: s.contact || '',
             montant: s.montant || 0, lib: s.lib || '', detail: s.detail || '',
             rappel: su.rappel || '' };
  }

  function peindreFiche(fil){
    var id = FICHE_ID; if(!id) return;
    var i = infosDe(id);
    var boite = el('ficheContenu');
    boite.innerHTML = '';

    var h1 = document.createElement('h2'); h1.id = 'ficheNom'; h1.className = 'ficheb__nom';
    h1.textContent = i.nom; boite.appendChild(h1);

    if(i.contact){
      var c = document.createElement('p'); c.className = 'ficheb__contact';
      i.contact.split(/\s+/).filter(Boolean).forEach(function(m, k){
        if(k) c.appendChild(document.createTextNode(' · '));
        var a = document.createElement('a');
        a.href = m.indexOf('@') > 0 ? 'mailto:' + m : 'tel:' + m.replace(/[^+0-9]/g, '');
        a.textContent = m;
        c.appendChild(a);
      });
      boite.appendChild(c);
    }
    if(i.montant || i.detail){
      var d = document.createElement('p'); d.className = 'ficheb__quoi';
      d.textContent = i.montant ? euros(i.montant) + ' ' + (i.lib || '') : i.detail;
      boite.appendChild(d);
    }

    // La prochaine action, en tete, comme dans le tableau de bord.
    var act = document.createElement('div'); act.className = 'ficheb__action';
    var lbl = document.createElement('span'); lbl.className = 'ficheb__action-l';
    if(i.rappel){
      lbl.textContent = 'À rappeler le ' + i.rappel.split('-').reverse().join('/');
      act.appendChild(lbl);
      var retire = document.createElement('button');
      retire.type = 'button'; retire.className = 'btn--lienb'; retire.textContent = 'retirer';
      retire.onclick = function(){
        // Le .catch est pose sur l'ECRITURE seule : chaine apres rafraichirApres, il
        // annoncerait un echec d'ecriture pour une simple erreur de repeinture.
        BdvCrm.planifier(id, null)
          .then(function(){ avisFiche(''); return rafraichirApres(); })
          .catch(function(){ avisFiche('Ce rappel n’a pas pu être retiré. Réessaie tout à l’heure.', false); });
      };
      act.appendChild(retire);
    }else{
      lbl.textContent = 'Aucune action prévue.';
      act.appendChild(lbl);
      [7, 30, 90].forEach(function(n){
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'btn--geste'; b.textContent = 'Dans ' + n + ' j';
        b.onclick = function(){
          BdvCrm.planifier(id, BdvCrm.dansNJours(n))
            .then(function(){ avisFiche(''); return rafraichirApres(); })
            .catch(function(){ avisFiche('Ce rappel n’a pas pu être posé. Réessaie tout à l’heure.', false); });
        };
        act.appendChild(b);
      });
    }
    boite.appendChild(act);

    // La saisie : une seule, comme dans le tableau de bord.
    var sais = document.createElement('div'); sais.className = 'saisieb';
    var ta = document.createElement('textarea');
    ta.className = 'saisieb__txt'; ta.rows = 2; ta.id = 'ficheTxt';
    ta.placeholder = 'Qu’est-ce qui s’est passé avec ce client ?';
    sais.appendChild(ta);
    var pied = document.createElement('div'); pied.className = 'saisieb__pied';
    var types = document.createElement('div'); types.className = 'saisieb__types';
    var etiq = document.createElement('label');
    etiq.className = 'saisieb__etiq'; etiq.setAttribute('for', 'ficheCanal');
    etiq.textContent = 'Par';
    var sel = document.createElement('select');
    sel.className = 'saisieb__canal'; sel.id = 'ficheCanal';
    if(window.BdvCanaux) BdvCanaux.remplirSelect(sel, CANAL_SAISIE);
    sel.onchange = function(){ CANAL_SAISIE = sel.value; };
    types.appendChild(etiq); types.appendChild(sel);
    pied.appendChild(types);
    var ok = document.createElement('button');
    ok.type = 'button'; ok.className = 'btn--geste'; ok.textContent = 'Enregistrer';
    ok.onclick = function(){
      var t = ta.value.trim();
      if(!t){ ta.focus(); return; }
      ok.disabled = true;
      BdvCrm.noter(id, CANAL_SAISIE, t).then(function(){
        ta.value = '';
        avisFiche('');
        BdvCrm.fil(id).then(function(f){ if(FICHE_ID === id) peindreFiche(f); });
      }).catch(function(){
        ok.disabled = false;
        avisFiche('Pas de réseau : cette note n’a pas pu être enregistrée. Réessaie tout à l’heure.', false);
      });
    };
    pied.appendChild(ok);
    sais.appendChild(pied);
    boite.appendChild(sais);

    // Le fil.
    var f = document.createElement('div'); f.className = 'filb';
    if(fil === undefined){
      var att = document.createElement('p'); att.className = 'zone__vide';
      att.textContent = 'Chargement de son historique…'; f.appendChild(att);
    }else if(fil === null){
      var ill = document.createElement('p'); ill.className = 'zone__vide';
      ill.textContent = 'Son historique n’a pas pu être lu. Ce n’est pas qu’il est vide : réessaie tout à l’heure.';
      f.appendChild(ill);
    }else if(!fil.length){
      var v = document.createElement('p'); v.className = 'zone__vide';
      v.textContent = 'Rien encore. Ce que tu écris ci-dessus s’inscrit ici, daté.'; f.appendChild(v);
    }else{
      var C = window.BdvCanaux;
      fil.forEach(function(e){
        var l = document.createElement('div'); l.className = 'filb__l';

        // La date de gauche est celle de CE QUI S'EST PASSE (`le`), jamais celle de la
        // derniere retouche. Un appel de mardi corrige jeudi reste un appel de mardi.
        var d = new Date(e.le);
        var q = document.createElement('span'); q.className = 'filb__q';
        q.textContent = isNaN(d) ? '' : d.toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'numeric' });
        var can = document.createElement('span'); can.className = 'filb__c';
        can.textContent = C ? C.libelleEntree(e) : (e.canal || e.type || '');
        q.appendChild(document.createElement('br')); q.appendChild(can);
        l.appendChild(q);

        var zone = document.createElement('span'); zone.className = 'filb__t';
        l.appendChild(zone);

        if(EDITION_ID && EDITION_ID === e.echange_id){ editer(e, zone); }
        else { lire(e, zone); }
        f.appendChild(l);
      });

      // Une entree telle qu'on la lit, avec le bouton qui ouvre la correction.
      function lire(e, zone){
        zone.textContent = '';
        var txt = document.createElement('span');
        txt.textContent = e.resume || (C ? C.libelleEntree(e) : e.type);
        zone.appendChild(txt);
        // « corrigé le » ne s'affiche que si la ligne a VRAIMENT ete reecrite. Le mettre
        // partout ferait douter de tout le journal, y compris de ce qui n'a pas bouge.
        if(e.maj_le && e.le && String(e.maj_le) !== String(e.le)){
          var md = new Date(e.maj_le);
          var m = document.createElement('span'); m.className = 'filb__maj';
          m.textContent = isNaN(md) ? 'corrigé' :
            ('corrigé le ' + md.toLocaleDateString('fr-FR', { day:'numeric', month:'short' }));
          zone.appendChild(m);
        }
        if(!e.echange_id) return;
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'btn--lienb filb__mod';
        b.textContent = 'corriger';
        b.setAttribute('aria-label', 'Corriger cette entrée du journal');
        b.onclick = function(){
          EDITION_ID = e.echange_id;
          EDITION_TXT = e.resume || '';
          EDITION_CANAL = (C && C.canal(e.canal)) ? C.canal(e.canal).cle : (C ? C.DEFAUT : 'appel');
          editer(e, zone);
          var z = zone.querySelector('textarea'); if(z) z.focus();
        };
        zone.appendChild(b);
      }

      // La correction, en place dans le fil. Pas de fenetre par-dessus une fenetre : la
      // fiche est deja en surimpression, et un deuxieme etage n'a plus d'issue au clavier.
      function editer(e, zone){
        zone.textContent = '';
        var boite = document.createElement('span'); boite.className = 'filb__ed';
        var ta = document.createElement('textarea');
        ta.className = 'saisieb__txt filb__edtxt'; ta.rows = 2;
        ta.value = (EDITION_TXT != null) ? EDITION_TXT : (e.resume || '');
        ta.oninput = function(){ EDITION_TXT = ta.value; };
        boite.appendChild(ta);

        var barre = document.createElement('span'); barre.className = 'filb__edpied';
        var sc = document.createElement('select'); sc.className = 'saisieb__canal';
        sc.setAttribute('aria-label', 'Moyen de communication');
        if(C) C.remplirSelect(sc, EDITION_CANAL);
        sc.onchange = function(){ EDITION_CANAL = sc.value; };
        barre.appendChild(sc);

        var ok = document.createElement('button');
        ok.type = 'button'; ok.className = 'btn--geste'; ok.textContent = 'Enregistrer';
        ok.onclick = function(){
          var v = ta.value.trim();
          if(!v){ ta.focus(); return; }
          ok.disabled = true;
          BdvCrm.corriger(FICHE_ID, e.echange_id, { resume: v, canal: sc.value })
            .then(function(){
              // On modifie l'entree en place plutot que de relire le fil : le serveur a
              // confirme, et un aller-retour de plus ferait clignoter la ligne corrigee.
              e.resume = v;
              e.canal = sc.value;
              e.maj_le = new Date().toISOString();
              if(C && C.canal(sc.value)) e.type = C.canal(sc.value).type;
              EDITION_ID = null; EDITION_TXT = null; EDITION_CANAL = null;
              avisFiche('');
              peindreFiche(fil);
            })
            .catch(function(){
              ok.disabled = false;
              avisFiche('Cette correction n’a pas pu être enregistrée. Ton texte est toujours là : réessaie tout à l’heure.', false);
            });
        };
        barre.appendChild(ok);

        var non = document.createElement('button');
        non.type = 'button'; non.className = 'btn--lienb'; non.textContent = 'annuler';
        non.onclick = function(){
          EDITION_ID = null; EDITION_TXT = null; EDITION_CANAL = null;
          lire(e, zone);
        };
        barre.appendChild(non);
        boite.appendChild(barre);
        zone.appendChild(boite);
      }
    }
    boite.appendChild(f);

    var lien = document.createElement('p'); lien.className = 'zone__pied';
    var a2 = document.createElement('a');
    a2.href = lienFiche(id); a2.textContent = 'Voir sa fiche complète dans le tableau de bord';
    lien.appendChild(a2); boite.appendChild(lien);
  }

  function rafraichirApres(){
    return BdvCrm.charger().then(function(etat){
      if(etat) ETAT_FILE = etat;
      peindreFile(); peindreResume(); peindrePanneau(); peindreFiche();
      BdvCrm.fil(FICHE_ID).then(function(f){ peindreFiche(f); });
    });
  }

  /* ---------------- LE PENSE-BETE ---------------- */
  var ECHEANCE = null;
  function peindreEcheance(){
    var boite = el('bureauEcheance');
    if(!window.BdvEcheances) return;
    ECHEANCE = BdvEcheances.laPlusPressante(BdvEcheances.depuisLaPage('bdvEcheances'));
    if(!ECHEANCE){ vide(boite, 'Rien en vue.'); return; }
