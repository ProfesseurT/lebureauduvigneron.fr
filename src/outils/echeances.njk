{# Les echeances vivent dans src/_data/echeances.json et pas dans cette page : une date qui
   change se corrige dans un fichier de donnees, sans toucher au code ni au calcul. #}
<script id="bdvEcheances" type="application/json">
{{ echeances | dump | safe }}
</script>

<section class="about-hero">
  <div class="container">
    <p class="section__label" style="color:var(--on-dark-soft)">Outil gratuit</p>
    <h1>Le calendrier réglementaire</h1>
    <p style="color:var(--on-dark-soft); font-style:italic; margin:0; font-size:1.05rem;">
      Ce qui tombe, et dans combien de jours. Sans compte, sans logiciel.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div id="echeancesListe" class="echeances"></div>

    {# LA PHRASE SUR LE REPORT AU JOUR OUVRE A ETE RETIREE LE 08/09/2026, sur
       decision de Ted. Elle promettait un calcul que `prochaine()` ne fait pas :
       la date affichee est celle du texte, brute. Promettre un calcul qu'on ne
       fait pas est pire que ne rien promettre. Ne pas la remettre sans ecrire le
       report ET les jours feries, qui sont calculables (cf. bdv-almanach.js). #}
    <p class="echeances__avis">
      Les dates viennent des textes officiels, chaque échéance porte sa source. Ce compte à
      rebours est un pense-bête, il ne remplace ni ton comptable ni ton service des douanes.
    </p>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="bureau-vide">
      <h2>Ne rate plus une date.</h2>
      <p>Crée ton compte du Bureau, gratuit et ouvert à toute la filière. Tu y retrouves ce
        compte à rebours en calendrier, en année ou en liste, avec les travaux de la vigne, les
        salons et les temps forts de vente, et tu coches ce qui est fait.</p>
      <p>
        <a href="/compte/" class="btn btn--bordeaux" data-bdv-compte
           data-bdv-titre="Ton bureau t'attend.">Créer mon compte</a>
        <a href="/mon-bureau/" class="btn btn--bordeaux" id="echeancesVersBureau" hidden>Ouvrir mon bureau</a>
      </p>
    </div>
  </div>
</section>

<script src="/js/bdv-echeances.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function(){
  'use strict';
  if(!window.BdvEcheances) return;

  /* LA PAGE PUBLIQUE NE MONTRE QUE LES OBLIGATIONS, et c'est la promesse de son
     titre : « Le calendrier réglementaire ». Depuis le lot 2 du 08/09/2026 le
     fichier de données porte aussi les travaux du domaine, les rendez-vous et les
     temps forts commerciaux. Les déverser ici ferait une page longue qui ne tient
     plus son titre, et surtout ça retirerait au Bureau la seule chose qu'il offre
     de plus : choisir ses familles, cocher, créer ses propres occurrences. */
  var lignes = BdvEcheances.calculer(
    BdvEcheances.deLaFamille(BdvEcheances.depuisLaPage('bdvEcheances'), 'obligations'));

  document.getElementById('echeancesListe').innerHTML = lignes.map(function(l){
    var e = l.e;
    return '<article class="echeance" data-niveau="' + l.niveau + '">'
      + '<div class="echeance__compte">'
      +   '<span class="echeance__quand">' + l.phrase + '</span>'
      +   '<span class="echeance__date">' + (l.periode || l.dateLongue) + '</span>'
      + '</div>'
      + '<div class="echeance__corps">'
      +   '<h2 class="echeance__titre">' + e.titre + '</h2>'
      +   '<p class="echeance__qui">' + e.qui + '</p>'
      +   (e.detail ? '<p class="echeance__detail">' + e.detail + '</p>' : '')
      +   '<p class="echeance__liens">'
      +     (e.article ? '<a href="' + e.article + '">Lire l\'article</a> · ' : '')
      +     (e.source ? '<a href="' + e.source + '" target="_blank" rel="noopener">Source : ' + e.sourceNom + '</a>' : '')
      +   '</p>'
      + '</div>'
      + '</article>';
  }).join('');

  // Deja connecte : on ne lui repropose pas de creer un compte, on lui ouvre son bureau.
  try{
    var s = JSON.parse(localStorage.getItem('bdv_session'));
    if(s && s.access_token && s.user){
      document.querySelector('[data-bdv-compte]').hidden = true;
      document.getElementById('echeancesVersBureau').hidden = false;
    }
  }catch(e){}
});
</script>
