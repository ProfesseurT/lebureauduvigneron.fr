<script src="/js/bdv-echeances.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';
  var zone = document.getElementById('boiteApercu');
  var cadre = document.getElementById('boiteApercuCadre');
  if (!zone || !cadre || !window.BdvEcheances) return;

  /* LES OBLIGATIONS SEULEMENT, comme sur /outils/echeances/. La vedette annonce un
     calendrier reglementaire : y glisser les travaux de la vigne ou les salons ferait
     un apercu qui ne ressemble pas a la page qu'il ouvre. */
  var lignes = BdvEcheances.calculer(
      BdvEcheances.deLaFamille(BdvEcheances.depuisLaPage('bdvOutilsEcheances'), 'obligations'))
    .filter(function (l) { return l.jours >= 0 || l.enCours; })
    .slice(0, 3);

  /* LE CADRE RESTE CACHE tant qu'il n'a pas de quoi le remplir : c'est l'etat par
     defaut du HTML, on ne fait que le lever ici. Un fichier de donnees illisible, ou
     un navigateur sans JavaScript, rendent donc une vedette simple, pas un trou. */
  if (!lignes.length) return;

  zone.innerHTML = lignes.map(function (l) {
    return '<span class="boite-apercu__ligne" data-niveau="' + l.niveau + '">'
      + '<span class="boite-apercu__quand">' + l.phrase + '</span>'
      + '<span class="boite-apercu__quoi">' + l.e.titre + '</span>'
      + '</span>';
  }).join('');
  cadre.hidden = false;
});
</script>
