{
  "name": "lebureauduvigneron",
  "version": "1.0.0",
  "description": "Le Bureau du Vigneron, LP pre-inscription",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "dev": "eleventy --serve",
    "charte": "node scripts/charte.mjs",
    "charte:dash": "node scripts/charte.mjs --bureau",
    "banc": "node scripts/banc-bureau.mjs",
    "charte:bureau": "node scripts/charte.mjs --bureau",
    "verif": "npm run build && npm run charte && npm run charte:bureau && npm run banc && npm run banc:journee && npm run banc:reglages && npm run banc:taches && npm run banc:calchoix && npm run banc:calclients && npm run banc:sync && npm run banc:lune && npm run banc:porte && npm run banc:registre && npm run banc:cap && npm run banc:commerce && npm run banc:tels && npm run banc:app && npm run courrier && npm run courrier:verif",
    "banc:reglages": "node scripts/banc-reglages.mjs",
    "banc:journee": "node scripts/banc-journee.mjs",
    "apercu:panneau": "node scripts/apercu-panneau.mjs",
    "apercu:fiche": "node scripts/apercu-fiche.mjs",
    "banc:taches": "node scripts/banc-taches.mjs",
    "banc:calchoix": "node scripts/banc-calchoix.mjs",
    "banc:calclients": "node scripts/banc-calclients.mjs",
    "banc:sync": "node scripts/banc-sync.mjs",
    "banc:lune": "node scripts/banc-lune.mjs",
    "banc:porte": "node scripts/banc-porte-import.mjs",
    "banc:registre": "node scripts/banc-registre.mjs",
    "banc:cap": "node scripts/banc-cap.mjs",
    "banc:commerce": "node scripts/banc-commerce.mjs",
    "banc:tels": "node scripts/banc-tels.mjs",
    "banc:app": "node scripts/banc-app.mjs",
    "courrier": "node scripts/apercu-courrier.mjs",
    "courrier:joindre": "node scripts/joindre-courrier.mjs",
    "courrier:verif": "node scripts/joindre-courrier.mjs --verifier"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "css-tree": "^3.2.1",
    "jsdom": "^30.0.1"
  }
}
